	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o ParametresFreinage.o ../modele/ParametresFreinage.cpp

Piste.o: ../modele/Piste.cpp ../modele/Piste.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Piste.o ../modele/Piste.cpp

